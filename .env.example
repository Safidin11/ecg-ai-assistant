# Скопируйте этот файл в .env и при необходимости отредактируйте значения

# Строка подключения к БД (SQLAlchemy). На старте — SQLite-файл.
DATABASE_URL=sqlite:///./data/app.db

# Где хранить оцифрованные сигналы (WFDB / .npy)
SIGNALS_STORAGE_PATH=./data/signals

# Где хранить исходные изображения ЭКГ
IMAGES_STORAGE_PATH=./data/images

# Окружение приложения: development / production
APP_ENV=development
